# Copy to .env.production. Never commit the real file.
# Generate every application secret independently, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_DB=china_smm_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-url-encoded-password@postgres:5432/china_smm_os

APP_ENV=production
DEMO_MODE=false
SECRET_KEY=replace-with-independent-secret
ADMIN_SECRET_KEY=replace-with-independent-secret
TENANT_SECRET_KEY=replace-with-independent-secret
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

PUBLIC_APP_URL=https://app.chinasmmos.com
CORS_ORIGINS=https://app.chinasmmos.com,https://chinasmmos.com
NEXT_PUBLIC_API_URL=https://api.chinasmmos.com/api/v1
MEDIA_BASE_URL=https://api.chinasmmos.com

USE_S3=true
S3_BUCKET=china-smm-os-media
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_BASE_URL=https://media.chinasmmos.com
S3_ACCESS_KEY=replace-with-r2-access-key
S3_SECRET_KEY=replace-with-r2-secret-key

OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4o

TELEGRAM_BOT_TOKEN=replace-with-telegram-token
TELEGRAM_ADMIN_ID=replace-with-telegram-user-id
TELEGRAM_WEBHOOK_SECRET=replace-with-independent-secret

META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_OAUTH_REDIRECT_URI=https://api.chinasmmos.com/api/v1/publishing/meta/oauth/callback
# Minimum scopes for Meta publish + Facebook Listening (comments + tagged mentions).
# Existing connected accounts must re-authorize after changing scopes — tokens do not
# gain new permissions automatically. Do not broaden beyond implemented features.
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_read_user_content,instagram_basic,business_management,pages_manage_posts,instagram_content_publish
LISTENING_META_WEBHOOK_VERIFY_TOKEN=replace-with-independent-secret

# Token for the named Cloudflare Tunnel whose ingress routes are:
# app.chinasmmos.com -> http://frontend:3000
# api.chinasmmos.com -> http://backend:8000
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

ENABLE_FACEBOOK_LIVE_SMOKE=false
ENABLE_INSTAGRAM_LIVE_SMOKE=false
SCHEDULED_PUBLISH_ENABLED=true

# Publish resilience (bounded retries for transient Meta/network failures)
PUBLISH_MAX_ATTEMPTS=5
PUBLISH_RETRY_BASE_SECONDS=60
PUBLISH_RETRY_MAX_SECONDS=3600
PUBLISH_STALE_ATTEMPT_MINUTES=5
PUBLISH_ATTEMPT_LEASE_SECONDS=300
# Publish operator alerts — in-app persisted; keep outbound channels false until verified
PUBLISH_ALERT_REPEATED_FAILURE_THRESHOLD=3
PUBLISH_ALERT_REPEATED_FAILURE_WINDOW_MINUTES=60
PUBLISH_ALERT_TELEGRAM_ENABLED=false
PUBLISH_ALERT_EMAIL_ENABLED=false
PUBLISH_ALERT_DELIVERY_COOLDOWN_SECONDS=300
PUBLISH_ALERT_TELEGRAM_WORKER_ENABLED=false
PUBLISH_ALERT_TELEGRAM_WORKER_POLL_SECONDS=5
PUBLISH_ALERT_TELEGRAM_WORKER_BATCH_SIZE=10
PUBLISH_ALERT_TELEGRAM_MAX_ATTEMPTS=8
PUBLISH_ALERT_TELEGRAM_RETRY_BASE_SECONDS=30
PUBLISH_ALERT_TELEGRAM_RETRY_MAX_SECONDS=3600
PUBLISH_ALERT_TELEGRAM_LEASE_SECONDS=120
PUBLISH_ALERT_TELEGRAM_RECOVERY_ENABLED=false
PUBLISH_ALERT_APP_BASE_URL=https://app.chinasmmos.com
# Operator Telegram self-enrollment — keep false until migration + code are deployed
PUBLISH_ALERT_TELEGRAM_ENROLLMENT_ENABLED=false
PUBLISH_ALERT_TELEGRAM_ENROLLMENT_TOKEN_TTL_SECONDS=600
PUBLISH_ALERT_TELEGRAM_ENROLLMENT_POLL_SECONDS=3
PUBLISH_ALERT_TELEGRAM_MAX_CONFIRMED_RECIPIENTS=1
TELEGRAM_BOT_USERNAME=
