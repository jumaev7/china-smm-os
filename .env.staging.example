# Staging-only env example for retry-command fake worker (B2b1-A).
# Copy to .env.staging for local use. NO production secrets.

APP_ENV=staging

PUBLISH_RETRY_COMMANDS_ENABLED=true
PUBLISH_RETRY_COMMAND_WORKER_ENABLED=true
PUBLISH_RETRY_COMMAND_CLAIM_ENABLED=true
PUBLISH_RETRY_COMMAND_EXECUTION_ENABLED=true

PUBLISH_RETRY_COMMAND_EXECUTION_BACKEND=fake
PUBLISH_RETRY_COMMAND_FAKE_EXECUTION_ALLOWED=true
PUBLISH_RETRY_COMMAND_FAKE_OUTCOME_MODE=success
PUBLISH_RETRY_COMMAND_WORKER_BATCH_SIZE=1
PUBLISH_RETRY_COMMAND_WORKER_POLL_SECONDS=5
PUBLISH_RETRY_COMMAND_LEASE_SECONDS=180

POSTGRES_DB=china_smm_os_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/china_smm_os_staging

# Must remain empty for fake staging bootstrap (hard fail if populated).
TELEGRAM_BOT_TOKEN=
META_APP_SECRET=

# Local Settings placeholders only — not production material.
SECRET_KEY=staging-local-only-not-for-production
ADMIN_SECRET_KEY=staging-local-only-admin-not-for-production
TENANT_SECRET_KEY=staging-local-only-tenant-not-for-production
