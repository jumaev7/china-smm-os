# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/china_smm_os
# Connection pool (optional — defaults shown)
# DB_POOL_SIZE=15
# DB_MAX_OVERFLOW=15
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_PROBE_CONCURRENCY=4
# HEALTH_SNAPSHOT_ENABLED=false
# ROUTE_PROBING_ENABLED=false

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# ── Governed AI Platform (Phase 2B — optional) ────────────────────────────────
# Secure defaults: AI disabled unless explicitly enabled AND a provider is usable.
# Mock provider supports the full test suite without network access.
# AI_PLATFORM_ENABLED=false
# AI_DEFAULT_PROVIDER=mock
# AI_FALLBACK_PROVIDER=
# AI_OPENAI_API_KEY=
# AI_CONTENT_MODEL_FAST=gpt-4o-mini
# AI_CONTENT_MODEL_STANDARD=gpt-4o
# AI_CONTENT_MODEL_HIGH_QUALITY=gpt-4o
# AI_REQUEST_TIMEOUT_SECONDS=45
# AI_MAX_INPUT_TOKENS=8000
# AI_MAX_OUTPUT_TOKENS=2000
# AI_MAX_REQUESTS_PER_TENANT_PER_HOUR=30
# AI_MAX_DAILY_TOKENS_PER_TENANT=200000
# AI_MAX_VARIANTS_PER_REQUEST=15
# AI_MAX_RETRY_COUNT=2
# AI_STORE_REDACTED_INPUT=true
# AI_STORE_REDACTED_OUTPUT=true
# AI_ROUTING_VERSION=1.0.0

# ── File Storage ──────────────────────────────────────────────────────────────
# Development: leave USE_S3=false, files go to ./media_storage
# Production:  set USE_S3=true and fill in S3 credentials
USE_S3=false
MEDIA_LOCAL_PATH=./media_storage
# Base URL for serving media files to the frontend. Must be reachable from the browser.
# In Docker: http://localhost:8000  |  In production: https://yourdomain.com
MEDIA_BASE_URL=http://localhost:8000

# S3-compatible storage (MinIO, Cloudflare R2, AWS S3, etc.)
S3_BUCKET=china-smm-os
S3_ENDPOINT_URL=http://localhost:9000
# Public HTTPS origin/CDN for objects (R2 custom domain or r2.dev URL).
# Do not use the R2 S3 API endpoint here.
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
# Production — use distinct values (required for Admin Security Hardening v1):
# APP_ENV=production
# ADMIN_SECRET_KEY=<long-random-secret>
# TENANT_SECRET_KEY=<different-long-random-secret>
ADMIN_SECRET_KEY=
TENANT_SECRET_KEY=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Set to true to test AI generation without OpenAI key (placeholder captions)
DEMO_MODE=false

# Telegram Bot (optional — enables content inbox from Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Business API (Meta Cloud API) — optional; demo mode works without credentials
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
LISTENING_META_WEBHOOK_VERIFY_TOKEN=
LISTENING_WORKER_ENABLED=false
LISTENING_WORKER_POLL_SECONDS=30
LISTENING_WORKER_BATCH_SIZE=20
ENABLE_FACEBOOK_LIVE_SMOKE=false
ENABLE_INSTAGRAM_LIVE_SMOKE=false

# Publish resilience (optional — defaults shown)
# PUBLISH_MAX_ATTEMPTS=5
# PUBLISH_RETRY_BASE_SECONDS=60
# PUBLISH_RETRY_MAX_SECONDS=3600
# PUBLISH_STALE_ATTEMPT_MINUTES=5
# PUBLISH_ATTEMPT_LEASE_SECONDS=300
# Publish operator alerts (in-app always; outbound opt-in — keep false until verified)
# PUBLISH_ALERT_REPEATED_FAILURE_THRESHOLD=3
# PUBLISH_ALERT_REPEATED_FAILURE_WINDOW_MINUTES=60
# PUBLISH_ALERT_TELEGRAM_ENABLED=false
# PUBLISH_ALERT_EMAIL_ENABLED=false
# PUBLISH_ALERT_DELIVERY_COOLDOWN_SECONDS=300
# Telegram alert outbox worker (all false by default; never enable without tenant allowlist)
# PUBLISH_ALERT_TELEGRAM_WORKER_ENABLED=false
# PUBLISH_ALERT_TELEGRAM_WORKER_POLL_SECONDS=5
# PUBLISH_ALERT_TELEGRAM_WORKER_BATCH_SIZE=10
# PUBLISH_ALERT_TELEGRAM_MAX_ATTEMPTS=8
# PUBLISH_ALERT_TELEGRAM_RETRY_BASE_SECONDS=30
# PUBLISH_ALERT_TELEGRAM_RETRY_MAX_SECONDS=3600
# PUBLISH_ALERT_TELEGRAM_LEASE_SECONDS=120
# PUBLISH_ALERT_TELEGRAM_RECOVERY_ENABLED=false
# PUBLISH_ALERT_APP_BASE_URL=https://app.chinasmmos.com
# Operator Telegram self-enrollment (keep false until migration + code deployed)
# PUBLISH_ALERT_TELEGRAM_ENROLLMENT_ENABLED=false
# PUBLISH_ALERT_TELEGRAM_ENROLLMENT_TOKEN_TTL_SECONDS=600
# PUBLISH_ALERT_TELEGRAM_ENROLLMENT_POLL_SECONDS=3
# PUBLISH_ALERT_TELEGRAM_MAX_CONFIRMED_RECIPIENTS=1

# Platform admin bootstrap (development only — no default credentials)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
